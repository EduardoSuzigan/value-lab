# Copie para .env e preencha. NUNCA commite o .env real (já está no .gitignore).
# Na produção, estes vão em Actions Secrets / env da Vercel.

# Postgres (Neon na produção). Local pode usar SQLite: sqlite:///./value_lab.db
DATABASE_URL=sqlite:///./value_lab.db

# The Odds API (Fase 2) — odds ao vivo + fechamento
ODDS_API_KEY=

# Protege a rota leve de refresh disparada por scheduler externo (Fase 2)
CRON_SECRET=
